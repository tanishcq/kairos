# Template for local settings. Copy it and set real values:
#   cp .env.example .env
# .env is gitignored: never commit real passwords.
POSTGRES_USER=kairos
POSTGRES_PASSWORD=change-me
POSTGRES_DB=kairos
# Signs login tokens (user-service). Must be 32+ characters: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-32-plus-char-value
